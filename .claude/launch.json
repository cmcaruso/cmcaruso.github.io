{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Jekyll Dev Server",
      "runtimeExecutable": "bundle",
      "runtimeArgs": ["exec", "jekyll", "serve", "--watch", "--port", "8080", "--livereload"],
      "port": 8080
    },
    {
      "name": "Docker Compose (full)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up"],
      "port": 8080
    },
    {
      "name": "Docker Compose (slim)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "-f", "docker-compose-slim.yml", "up"],
      "port": 8080
    }
  ]
}
